		(uuid "226646e7-fe04-5e01-86bc-4d76419e43b1")
	)
	(text "LMR33640ADDA: 400 kHz, internal compensation. L1 6.8 uH and 3 x 22 uF per datasheet table 9-2."
		(exclude_from_sim no)
		(at 17.78 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1f3b84df-2898-5edf-8a78-8a4ca3b7645c")
	)
	(text "Vout = 1.0 V x (1 + R25 / R26) = 5.10 V.  C28 = VCC bypass (internal 5 V LDO)."
		(exclude_from_sim no)
		(at 17.78 173.99 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "dee223ce-9202-5e2d-895a-17302b4012b1")
	)
	(text "LMR33640 max input 38 V: D3 SMBJ22A clamps at about 35.5 V."
		(exclude_from_sim no)
		(at 17.78 177.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "38ced148-b1e4-565f-8080-115a6335e3b9")
	)
	(text "+3.3VA is a quiet analog rail for the codec (AVDD, DRVDD). +1V8 feeds the codec core (DVDD)."
		(exclude_from_sim no)
		(at 17.78 181.61 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9369a0fb-f1ed-533d-a5db-42de474b8ff4")
	)
	(text "D3 is drawn with the Zener symbol: KiCad's convention for a unidirectional TVS."
