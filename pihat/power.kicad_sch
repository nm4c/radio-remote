		(uuid "96d22d5c-a5f9-4f5e-bcf5-324b55351b26")
	)
	(text "TPS54360 can't sink current, so no back-feed diode is needed (HAT design guide)."
		(exclude_from_sim no)
		(at 17.78 177.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "aef188c4-9a32-4c4a-9521-0d6d51bb3fec")
	)
	(text "+3.3VA is a quiet analog rail for the codec (AVDD, DRVDD). +1V8 feeds the codec core (DVDD)."
