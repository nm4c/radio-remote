#!/usr/bin/env bash
# radio-users: manage Radio Remote operator accounts and read the audit log.
# Installed to /usr/local/bin by install.sh / update.sh. Run with sudo, e.g.:
#   sudo radio-users add vk3abc --role control      sudo radio-users list
#   sudo radio-users add guest --role listen         sudo radio-users log --days 1
# It runs as the 'radio' user so the database keeps its owner, and records who ran it.
set -euo pipefail
if [[ $EUID -ne 0 ]]; then echo "run with sudo: sudo radio-users $*"; exit 1; fi
cd /opt/radio-remote
exec sudo -u radio env RADIO_USERS_BY="${SUDO_USER:-root}" \
  /opt/radio-remote/.venv/bin/python -m server.users -c /opt/radio-remote/config.yaml "$@"
