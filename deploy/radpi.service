[Unit]
Description=RadPi (web remote head for a two-way radio)
After=network-online.target sound.target
Wants=network-online.target

[Service]
User=radio
Group=radio
SupplementaryGroups=gpio audio
WorkingDirectory=/opt/radpi
ExecStart=/opt/radpi/.venv/bin/python -m server -c /opt/radpi/config.yaml
Restart=always
RestartSec=3
# Audio thread benefits from a bit of priority.
Nice=-5

[Install]
WantedBy=multi-user.target
