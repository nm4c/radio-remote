	)
	(text "COMPENSATION  (datasheet 8.2.2.11)"
		(exclude_from_sim no)
		(at 93.98 93.98 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "fb249c15-9cb4-56fd-becd-ebbffd9e86e0")
	)
	(text "Cout 3 x 22uF at 4.2 V = 45 uF, Iout 1 A"
		(exclude_from_sim no)
		(at 93.98 97.79 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a7862b2a-ec0d-5fc6-bdfe-61acb5641cea")
	)
	(text "fp = 1 A / (2 pi 4.2 V 45 uF) = 842 Hz"
		(exclude_from_sim no)
		(at 93.98 100.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6eda4fc0-2725-5fe2-bea4-9e63de496374")
	)
	(text "fco = sqrt(fp x fsw / 2) = 16.5 kHz"
		(exclude_from_sim no)
		(at 93.98 104.15 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "305b58a6-5831-5f86-baac-19fa6af5e3e4")
	)
	(text "R33 = 2 pi fco Cout Vout / (gmps Vref gmea) = 5.8k -> 5.6k"
