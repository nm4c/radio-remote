		(at 93.98 107.33 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d745577e-c00b-579f-b2c9-07fde22276df")
	)
	(text "C36 = 1 / (2 pi R33 fp) = 34 nF -> 33 nF"
