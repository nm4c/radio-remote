	(text "U7 TPS7A9401DSCR (TI): 1 A, 0.46 uVrms, PSRR 110 dB @ 1 kHz / 50 dB @ 1 MHz, dropout 240 mV max at 1 A."
		(exclude_from_sim no)
		(at 17.78 133.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e1a5cd42-9455-5951-86dd-bc47b2edb152")
	)
	(text "Headroom: 5.0 V - 4.2 V = 0.8 V; still 0.55 V if the Pi's 5 V sags to 4.75 V on TX."
		(exclude_from_sim no)
		(at 17.78 137.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ad785847-54a5-53b5-bf27-a71afc06ab86")
	)
	(text "R31 sets Vout with the internal 150 uA reference: thin film 0.1% for accuracy and low excess noise."
		(exclude_from_sim no)
		(at 17.78 140.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "228da496-d7bb-5415-91cc-2762d820e039")
	)
	(text "C34 on NR/SS filters the reference (start-up about 28 ms). C31-C35: X7R ceramics only - the output"
		(exclude_from_sim no)
		(at 17.78 144.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cb3fee82-ee74-573c-92e3-78b8792d38a8")
	)
	(text "  needs 1-20 mOhm ESR and under 2 nH (datasheet 6.3), which rules out tantalum here."
		(exclude_from_sim no)
		(at 17.78 148.59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8534b8b1-2a08-5b0b-9c26-e97f33b99ba5")
	)
	(text "Layout: C31/C32 at IN, C33/C35 at OUT, grounds together at U7's GND with no vias in between."
		(exclude_from_sim no)
		(at 17.78 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a0f36a21-da95-5418-b4d1-12527a19194c")
	)
	(text "  SNS (pin 8) Kelvin to C33. Thermal pad to a large ground area: 0.6 W on TX, RthJA 46 C/W (JEDEC)."
		(exclude_from_sim no)
		(at 17.78 156.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4b2fa9b8-1f51-51f8-90f0-a95eefd29923")
	)
	(text "R36 || R37 = 9.4k sets the full 1.3 A current limit. PG is not used (left open, as the datasheet allows)."
		(exclude_from_sim no)
		(at 17.78 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "015c1e87-542c-5d71-9365-7c9d26d397c0")
	)
	(text "FB1 BLM21PG221SN1D (220 ohm @ 100 MHz, 2 A, 45 mOhm) + C38/C39: pi-filter at the module's VBAT pad."
		(exclude_from_sim no)
		(at 17.78 163.83 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3d1fea7e-bbaa-5d17-9132-aa56163058e3")
	)
	(text "C39 polymer tantalum (35 mOhm) damps that pi-filter and holds up the 0.75 A step at key-up."
		(exclude_from_sim no)
		(at 17.78 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "dd2e46b5-aa3b-5b8d-a309-9571324a4010")
	)
